# Fantrax Value Hunter - Environment Variables
# Copy this file to .env and fill in your values for local development

# Database Configuration (Local Development)
# These are used when DATABASE_URL is not provided
PGHOST=localhost
PGPORT=5433
PGUSER=fantrax_user
PGPASSWORD=fantrax_password
PGDATABASE=fantrax_value_hunter

# Railway Production Database
# Railway automatically provides DATABASE_URL in format:
# DATABASE_URL=postgresql://user:password@host:port/database

# Integration Package Path (Optional - for backward compatibility)
# The integration package is now included in the project, but you can override the path
# Leave empty or remove to use the included integration package
# INTEGRATION_PATH=C:/Users/halvo/.claude/Fantrax_Expected_Stats

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true

# Production Settings (Railway automatically sets these)
# FLASK_ENV=production
# FLASK_DEBUG=false

# Optional: Caching Configuration
# CACHE_TYPE=simple
# CACHE_DEFAULT_TIMEOUT=60

# Port Configuration (Railway handles this automatically)
# PORT=5001