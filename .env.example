# Environment Variables for Fantrax Value Hunter
# Copy this file to .env and fill in your actual values

# Railway Database URL (optional - fallback credentials are provided)
# RAILWAY_DATABASE_URL=postgresql://postgres:your_password@your_host:port/railway

# Local Development Database (default values)
# LOCAL_DB_HOST=localhost
# LOCAL_DB_PORT=5433
# LOCAL_DB_USER=fantrax_user
# LOCAL_DB_PASSWORD=fantrax_password
# LOCAL_DB_NAME=fantrax_value_hunter
